# --- Chain ---
# mainnet (chain 143) or testnet (chain 10143)
NEXT_PUBLIC_MONAD_NETWORK=mainnet
# Optional custom RPC (server-side reads)
MONAD_RPC_URL=

# --- Sessions ---
# Signs the wallet session cookie. 32+ random chars. Required in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Wallet ---
# Free at https://cloud.reown.com. Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Chog NFT ---
# Chog Genesis ERC-721 on Monad mainnet (chain 143)
CHOG_CONTRACT_ADDRESS=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
# Optional. Used to list token IDs if the contract is not ERC721Enumerable
ALCHEMY_API_KEY=
IPFS_GATEWAY=https://ipfs.io

# CHOG token (ERC-20) on Monad mainnet. Balances count across all linked wallets.
CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777
# Minimum CHOG (whole tokens) for the CHOG holder level. Leave empty to keep that level off.
CHOG_TOKEN_MIN=
# Demo CHOG balances for testing without RPC: 0xabc:5000,0xdef:12.5
DEMO_CHOG_BALANCES=

# Demo override: these wallets count as holders and get the demo Chog
DEMO_HOLDER_ADDRESSES=
DEMO_CHOG_IMAGE_URL=

# --- Video generation ---
# Provider order: deAPI if DEAPI_API_KEY is set, else Replicate, else demo mode (sample clip).

# deAPI: $5 free credit at signup, no card. Key from deapi.ai dashboard.
DEAPI_API_KEY=
# Video model. Default LTX-2.3 22B distilled (8 steps, 24 fps, about 5 s, sizes picked
# from the model's presets to match the image). Set Ltxv_13B_0_9_8_Distilled_FP8 for the
# older model. If deAPI refuses the default, Dubu retries on the older model by itself.
VIDEO_MODEL=

# Replicate (paid)
REPLICATE_API_TOKEN=
REPLICATE_MODEL=wan-video/wan-2.2-i2v-fast
# Extra model inputs per tier, as JSON
REPLICATE_INPUT_HOLDER={"resolution":"720p"}
REPLICATE_INPUT_FREE={"resolution":"480p"}

# --- Redis (required on Vercel for limits to hold) ---
# Set automatically by the Upstash integration in Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Limits (per UTC day) ---
HOLDER_DAILY_LIMIT=50
TOKEN_DAILY_LIMIT=10
FREE_DAILY_LIMIT=3
# Free videos per network (IP). Passkey wallets are free to create, so this protects the video credit.
FREE_IP_DAILY_LIMIT=6

# --- Images ---
# CHOG token logo, served through /api/logo/chog. Defaults to the CoinGecko listing logo.
CHOG_TOKEN_LOGO_URL=
# Chog Genesis token IDs on the landing page reel
SHOWCASE_CHOG_IDS=

# --- Withdraw: send MON or CHOG out of the sign-in wallet ---
# On unless set to false. A kill switch, not a gate: people must be able to move their own funds.
WITHDRAW_ENABLED=true

# --- Swap: buy and sell CHOG with MON (mainnet) ---
# Off until a real canary swap has passed. Canary wallets can use it before that.
SWAP_ENABLED=false
SWAP_CANARY_ADDRESSES=
SWAP_MIN_MON=0.01
SWAP_MAX_MON=100
SWAP_MIN_CHOG=0.01
SWAP_MAX_CHOG=10000000
WMON_ADDRESS=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
# Nad.fun v3 (github.com/Naddotfun/contract-v3-abi)
NADFUN_LENS=0x7e78A8DE94f21804F7a17F4E8BF9EC2c872187ea
NADFUN_BONDING_ROUTER=0x6F6B8F1a20703309951a5127c45B49b1CD981A22
NADFUN_DEX_ROUTER=0x0B79d71AE99528D1dB24A4148b5f4F865cc2b137
# Uniswap v3 on Monad (SwapRouter02, QuoterV2)
UNISWAP_V3_ROUTER=0xfe31f71c1b106eac32f1a19239c9a9a72ddfb900
UNISWAP_V3_QUOTER=0x661e93cca42afacb172121ef892830ca3b70f08d

# --- Director ---
# Writes the shot for each video from the image and the user's sentence, and
# screens uploads before any video credit is spent. Off when unset. Server only.
DIRECTOR_API_KEY=
# Optional model override.
DIRECTOR_MODEL=
